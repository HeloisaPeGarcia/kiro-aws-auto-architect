{
  "name": "aws-serverless-auto-architect-power",
  "version": "1.0.0",
  "description": "Kiro Power para detecção de chamadas AWS SDK e geração de CDK com Least Privilege IAM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "auto-architect": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "scan": "node dist/cli.js scan",
    "apply": "node dist/cli.js apply",
    "drift": "node dist/cli.js drift",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo": "node examples/demo_runner.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/__tests__/**"
    ]
  },
  "keywords": [
    "kiro",
    "power",
    "aws",
    "cdk",
    "iam",
    "least-privilege",
    "serverless",
    "devsecops"
  ],
  "author": "",
  "license": "MIT"
}
